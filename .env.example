# ---- Trích nguồn y văn cho nhãn đã chốt (src/source_support/, "part 3") ----
# Mặc định TẮT. Chạy SAU agent quyết định, KHÔNG BAO GIỜ đổi triage_label - đường duy nhất nó tác
# động tới ca là bật thêm requires_human_review.
# CẢNH BÁO PHI: bước tách claim gửi source_span (trích NGUYÊN VĂN báo cáo bệnh nhân) sang provider
# LLM. Chính sách dùng dữ liệu của free tier khác tier trả phí - chốt trước khi bật trên dữ liệu thật.
SOURCE_SUPPORT_ENABLED=false
# Ngưỡng cosine coi như index đã phủ được một claim. Đây là núm vặn CHI PHÍ chứ không chỉ chất lượng:
# hạ ngưỡng = ít lần search hơn = rẻ hơn nhiều, đổi lại quote yếu hơn. Phải hiệu chỉnh bằng đo thật.
SOURCE_SUPPORT_THRESHOLD=0.55
SOURCE_SUPPORT_MAX_CLAIMS=3
# true = bỏ hẳn bước search + nạp trang. Bật khi chưa có TAVILY_API_KEY, và khi chạy đo hit-rate lặp.
SOURCE_SUPPORT_INDEX_ONLY=false
# Guard 1 so theo NHÃN TÊN MIỀN nên nhs.uk.evil.com không lọt.
SOURCE_SUPPORT_ALLOWLIST=who.int,moh.gov.vn,kcb.vn,nhs.uk,nice.org.uk,cdc.gov,ncbi.nlm.nih.gov,cochranelibrary.com,msdmanuals.com,aafp.org,acep.org

# ---- Định tuyến provider THEO TỪNG BƯỚC (bỏ trống = kế thừa LLM_PROVIDER_ORDER) ----
# Ba bước dùng model của part 3 có hình dạng rủi ro khác hẳn nhau, nên định tuyến riêng: bước nào
# trượt cổng lọc chất lượng thì CHỈ bước đó quay về provider đắt hơn.
#   claim_splitter  - sai ở đây KHÔNG guard nào phía sau bắt được (đã chặn bằng Guard 0a/0b bằng code)
#   source_verdict  - guard ngữ nghĩa DUY NHẤT của thiết kế post-hoc, KHÔNG được hạ chất lượng
#   source_explain  - đầu ra bị guard 5 kiểm bằng so chuỗi
ROLE_ORDER_CLAIM_SPLITTER=
ROLE_ORDER_SOURCE_VERDICT=
ROLE_ORDER_SOURCE_EXPLAIN=
