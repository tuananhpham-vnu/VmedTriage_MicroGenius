# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=your-gemini-key-here
# GOOGLE_API_KEY=your-google-api-key-here  # fallback for GEMINI_API_KEY

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL production example (install a PostgreSQL driver first):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

# ---- Authentication ----
# Generate a long random value for production, for example: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Required only when registering a nurse account
NURSE_REGISTRATION_CODE=replace-with-a-private-invite-code

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
WEAVIATE_URL=
WEAVIATE_API_KEY=
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
