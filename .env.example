# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# OPENAI_API_KEY=your-key-here
DEEPSEEK_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
OPEN_ROUTER_API_KEY=your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here

# ---- Database ----
DATABASE_URL=your-key-here
# DATABASE_URL=your-key-here
# For SQLite (development):
JWT_SECRET_KEY=your-key-here
NURSE_REGISTRATION_CODE=your-key-here

# ---- Vector Store ----
CHROMA_PERSIST_DIR=your-key-here
WVC_URL=your-key-here
WEAVIATE_URL=your-key-here
WVC_API_KEY=your-key-here
WEAVIATE_API_KEY=your-key-here
# Or Pinecone:
# PINECONE_API_KEY=your-key-here
# PINECONE_ENVIRONMENT=your-key-here

# ---- App Config ----
APP_ENV=your-key-here
APP_PORT=your-key-here
APP_HOST=your-key-here
CORS_ORIGINS=your-key-here

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-key-here
LANGCHAIN_PROJECT=your-key-here
LANGCHAIN_TRACING_V2=your-key-here

# ---- Logging ----
LOG_LEVEL=your-key-here

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=your-key-here
AI_LOG_API_KEY=your-key-here
AI_LOG_DIR=your-key-here

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=your-key-here

# ---- Hugging face ----
HUGGINGFACE_API_KEY=your-key-here

# ---- LLM Model Provider (CORE - reasoning) ----
# Giá trị hợp lệ: auto | openai | deepseek | gemini | anthropic | openrouter (xem src/config.py)
# "auto" =your-key-here
# Đặt tên một provider cụ thể sẽ ép dùng DUY NHẤT provider đó và TẮT fallback.
LLM_PROVIDER=your-key-here
LLM_PROVIDER_ORDER=your-key-here
DEEPSEEK_MODEL_NAME=your-key-here
GEMINI_MODEL_NAME=your-key-here
EMBEDDING_MODEL_NAME=your-key-here

# ---- LLM Model Provider (Supporter - mapping, retrieval) ----
SUPPORTED_MODEL_NAME=your-key-here

# ---- Research / read tools ----
TAVILY_API_KEY=your-key-here
FIRECRAWL_API_KEY=your-key-here
RAPIDAPI_KEY=your-key-here
RAPIDAPI_TWITTER_HOST=your-key-here
ARXIV_USER_AGENT=your-key-here
# Tôi đọc kỹ 5 file và tìm thấy mâu thuẫn nhãn ở mức nguy hiểm cho hệ an toàn:

SMTP_HOST=your-key-here
SMTP_PORT=your-key-here
SMTP_USERNAME=your-key-here
SMTP_PASSWORD=your-key-here
SMTP_FROM_EMAIL=your-key-here
SMTP_USE_TLS=your-key-here
