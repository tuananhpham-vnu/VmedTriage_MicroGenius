# ---- LLM Model Provider (CORE - reasoning) ----
# Giá trị hợp lệ: auto | openai | deepseek | gemini | anthropic | openrouter (xem src/config.py)
# "auto" = duyệt theo LLM_PROVIDER_ORDER, provider nào còn key hợp lệ thì dùng, lỗi thì chuyển tiếp.
# Đặt tên một provider cụ thể sẽ ép dùng DUY NHẤT provider đó và TẮT fallback.
LLM_PROVIDER="auto"
LLM_PROVIDER_ORDER="openrouter,gemini,deepseek,openai,anthropic"
OPENROUTER_MODEL_NAME="openai/gpt-4o-mini"
DEEPSEEK_MODEL_NAME="deepseek-chat"
GEMINI_MODEL_NAME="gemini-3.1-flash-lite"
GPT_MODEL_NAME="gpt-4o-mini" # openai
EMBEDDING_MODEL_NAME="bkai-foundation-models/vietnamese-bi-encoder"

# ---- OpenRouter: xoay vòng model free ----
# Để TRỐNG OPENROUTER_MODEL_NAME = dùng danh sách model free bên dưới, thử lần lượt từ trên xuống khi
# model trước bị 429/402/404. Đặt tên model ở đây thì model đó được thử TRƯỚC, danh sách free vẫn là
# phương án dự phòng.
OPENROUTER_MODEL_NAME=
# Bỏ comment và sửa dòng dưới nếu muốn khác mặc định trong src/config.py (OPENROUTER_FREE_MODELS).
# OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-26b-a4b-it:free
# Trần số model thử trong MỘT lần gọi (mỗi model lỗi tốn một vòng HTTP).
OPENROUTER_MAX_MODEL_ATTEMPTS=4

# ---- LLM Model Provider (Supporter - mapping, retrieval) ----
SUPPORTED_MODEL_NAME="Qwen/Qwen3-8B" # hugging face

# ---- Agent quyet dinh tren Patient Graph (src/graph_triage/) ----
# Mac dinh TAT: can requirements-graph.txt (torch ~2.5 GB) va 3 artifact trong runs/:
# logreg_full/, bert_full/, fusion_full/. Thieu fusion_full thi tinh nang TAT HAN chu khong
# chay 2 model - y kien dung tren 3 model va tren 2 model khong so sanh duoc voi nhau.
# Bat len la moi ca chot phieu ton them 1 loi goi DeepSeek + vai luot OpenAI.
ENABLE_GRAPH_TRIAGE_AGENT=false
# Bo trong = dung <repo>/runs
GRAPH_TRIAGE_ARTIFACT_ROOT=
GRAPH_TRIAGE_MAX_LENGTH=256

