# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
DEEPSEEK_API_KEY=sk-your-key-here
GEMINI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
WVC_URL=sk-your-key-here
WEAVIATE_URL=sk-your-key-here
WVC_API_KEY=sk-your-key-here
WEAVIATE_API_KEY=sk-your-key-here 
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=sk-your-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Hugging face ----
HUGGINGFACE_API_KEY=hf_your-key-here

# ---- LLM Model Provider (CORE - reasoning) ----
# Giá trị hợp lệ: auto | openai | deepseek | gemini | anthropic | openrouter (xem src/config.py)
LLM_PROVIDER="deepseek"
DEEPSEEK_MODEL_NAME="deepseek-chat"
GEMINI_MODEL_NAME="gemini-3.5-flash-lite"
EMBEDDING_MODEL_NAME="bkai-foundation-models/vietnamese-bi-encoder"

# ---- LLM Model Provider (Supporter - mapping, retrieval) ----
SUPPORTED_MODEL_NAME="Qwen/Qwen3-8B" # hugging face

# ---- Research / read tools ----
TAVILY_API_KEY=api-key-your-key-here
FIRECRAWL_API_KEY=api-key-your-key-here
RAPIDAPI_KEY=api-key-your-key-here
RAPIDAPI_TWITTER_HOST=api.twitter.com
ARXIV_USER_AGENT=app-name-your-key-here
# Tôi đọc kỹ 5 file và tìm thấy mâu thuẫn nhãn ở mức nguy hiểm cho hệ an toàn:

